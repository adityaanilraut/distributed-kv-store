{
  "title": "Five-node Raft",
  "uid": "raft",
  "schemaVersion": 40,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1, "title": "Leader elections", "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"uid": "raft-prometheus"},
      "targets": [{"refId": "A", "expr": "sum(increase(raft_leader_elections_total[1m]))"}]
    },
    {
      "id": 2, "title": "p95 commit latency (seconds)", "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"uid": "raft-prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(raft_commit_seconds_bucket[1m])))"}]
    },
    {
      "id": 3, "title": "Replication lag (entries)", "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 8},
      "datasource": {"uid": "raft-prometheus"},
      "targets": [{"refId": "A", "expr": "raft_replication_lag_entries", "legendFormat": "{{instance}} → {{peer}}"}]
    }
  ]
}
